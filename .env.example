# Gateway service ----------------------------------------------------------
# Required. Comma-separated list of allowed bearer tokens. Clients must send:
#   Authorization: Bearer <one of these keys>
# Allowed characters per key: A-Z a-z 0-9 . _ ~ + / = -
API_KEYS=

# Optional. Defaults match the template's internal wiring; only override if
# you rename the mcp service.
# MCP_HOST=grafana-mcp.railway.internal
# MCP_PORT=8000

# Optional. Port nginx listens on. Pinned to 80 by the IaC file; Railway
# injects a random value when unset, which must then match the domain's
# target port.
# PORT=80

# Optional. Credential the gateway presents to the mcp service. Must equal the
# mcp service's MCP_GRAFANA_SERVER_TOKEN. Required if you enable PATH_KEY_AUTH
# alongside MCP_GRAFANA_SERVER_TOKEN.
# MCP_SERVER_TOKEN=

# Optional. `true` also accepts the key as a path segment: /k/<key>/mcp
# MCP clients that cannot send an Authorization header need this.
# PATH_KEY_AUTH=false

# MCP service --------------------------------------------------------------
# Required. Base URL of your Grafana instance. On Railway, use the private
# network: http://<grafana-service>.railway.internal:<port>
GRAFANA_URL=

# Grafana auth — set EITHER the service account token (recommended) OR both
# GRAFANA_USERNAME and GRAFANA_PASSWORD.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# GRAFANA_USERNAME=
# GRAFANA_PASSWORD=

# Optional. `restricted` (default) passes --disable-write to mcp-grafana.
# ACCESS_MODE=restricted

# Optional. Port the MCP server listens on. Railway injects PORT.
# PORT=8000

# Optional. Second auth layer — mcp-grafana requires this bearer token from
# callers. Must equal the gateway's MCP_SERVER_TOKEN.
# MCP_GRAFANA_SERVER_TOKEN=

# Optional. Comma-separated allowlist of tool categories, e.g. loki,prometheus.
# ENABLED_TOOLS=

# Optional. debug | info | warn | error
# LOG_LEVEL=info
